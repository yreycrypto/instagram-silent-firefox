{
  "manifest_version": 3,
  "name": "Instagram /silent",
  "version": "1.0.0",
  "description": "Automatically puts /silent at the start of the message box in Instagram web chats, so you never type it by hand.",
  "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"},
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Instagram /silent",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-silent@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
